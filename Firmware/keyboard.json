{
    "manufacturer": "Abdul Rehman",
    "keyboard_name": "hackpadv2",
    "maintainer": "abdulrehman8912",

    "processor": "atmega32u4",
    "bootloader": "caterina",

    "diode_direction": "COL2ROW",

    "matrix_pins": {
        "cols": ["F4", "F5", "F6"],
        "rows": ["B1", "B3", "B2"]
    },

    "features": {
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "encoder": true,
        "oled": true
    },

    

    "oled": {
        "driver": "SSD1306"
    },

"encoder": {
    "rotary": [
        {
            "pin_a": "B4",
            "pin_b": "B5",
            "resolution": 4
        }
    ]
},

    "layouts": {
        "LAYOUT_3x3": {
            "layout": [
                { "matrix": [0,0], "x":0, "y":0 },
                { "matrix": [0,1], "x":1, "y":0 },
                { "matrix": [0,2], "x":2, "y":0 },

                { "matrix": [1,0], "x":0, "y":1 },
                { "matrix": [1,1], "x":1, "y":1 },
                { "matrix": [1,2], "x":2, "y":1 },

                { "matrix": [2,0], "x":0, "y":2 },
                { "matrix": [2,1], "x":1, "y":2 },
                { "matrix": [2,2], "x":2, "y":2 }
            ]
        }
    }
}